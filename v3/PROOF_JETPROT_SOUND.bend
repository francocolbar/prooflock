# PROOF_JETPROT_SOUND.bend - proofs of LAWS_JETPROT_SOUND.bend: the Bool equality
# predicates of spec_jetprot.bend are sound (True{} forces propositional equality), and
# lvl_le is reflexive and antisymmetric under both urgency orders. Every proof is an
# exhaustive case split (no induction): diagonal rows close by computation ({==}); an
# off-diagonal row has a hypothesis that computes to {False{} == True{} : Bool}, refuted
# by clash_ft. fin_eq_sound projects the six conjuncts (and_l / and_r), applies the five
# component lemmas and rewrites the goal field by field. Generated by a script; the rows
# are listed explicitly because a wildcard row would not refine the scrutinees.
import Base
import ./jetprot.bend as S
import ./spec_jetprot.bend as Spec
import ./LAWS_JETPROT_SOUND.bend as Laws

# ---------------------------------------------------------------------------
# Bool facts (same as PROOF_JETPROT.bend)
# ---------------------------------------------------------------------------

# the motive of a Bool clash: sends True to the wanted type and False to Unit
def At(A: Type, b: Bool) -> Type:
  match b:
    case True{}:
      A
    case False{}:
      Unit

# anything follows from False == True
def clash_ft(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : At(A, _)
  Unit{}

def and_l(a: Bool, -b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      h

def and_r(a: Bool, -b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      clash_ft({b == True{} : Bool}, h)

# ---------------------------------------------------------------------------
# Soundness of the equality predicates
# ---------------------------------------------------------------------------

# beq: 2 x 2 rows
def Laws.beq_sound(a, b, h):
  match a b:
    case True{} True{}:
      {==}
    case True{} False{}:
      clash_ft({True{} == False{} : Bool}, h)
    case False{} True{}:
      clash_ft({False{} == True{} : Bool}, h)
    case False{} False{}:
      {==}

# unit_eq: 4 x 4 rows
def Laws.unit_eq_sound(a, b, h):
  match a b:
    case S.Off{} S.Off{}:
      {==}
    case S.Off{} S.Inhibited{}:
      clash_ft({S.Off{} == S.Inhibited{} : S.Heat}, h)
    case S.Off{} S.Ramping{}:
      clash_ft({S.Off{} == S.Ramping{} : S.Heat}, h)
    case S.Off{} S.On{}:
      clash_ft({S.Off{} == S.On{} : S.Heat}, h)
    case S.Inhibited{} S.Off{}:
      clash_ft({S.Inhibited{} == S.Off{} : S.Heat}, h)
    case S.Inhibited{} S.Inhibited{}:
      {==}
    case S.Inhibited{} S.Ramping{}:
      clash_ft({S.Inhibited{} == S.Ramping{} : S.Heat}, h)
    case S.Inhibited{} S.On{}:
      clash_ft({S.Inhibited{} == S.On{} : S.Heat}, h)
    case S.Ramping{} S.Off{}:
      clash_ft({S.Ramping{} == S.Off{} : S.Heat}, h)
    case S.Ramping{} S.Inhibited{}:
      clash_ft({S.Ramping{} == S.Inhibited{} : S.Heat}, h)
    case S.Ramping{} S.Ramping{}:
      {==}
    case S.Ramping{} S.On{}:
      clash_ft({S.Ramping{} == S.On{} : S.Heat}, h)
    case S.On{} S.Off{}:
      clash_ft({S.On{} == S.Off{} : S.Heat}, h)
    case S.On{} S.Inhibited{}:
      clash_ft({S.On{} == S.Inhibited{} : S.Heat}, h)
    case S.On{} S.Ramping{}:
      clash_ft({S.On{} == S.Ramping{} : S.Heat}, h)
    case S.On{} S.On{}:
      {==}

# dms_eq: 3 x 3 rows
def Laws.dms_eq_sound(a, b, h):
  match a b:
    case S.DmsIdle{} S.DmsIdle{}:
      {==}
    case S.DmsIdle{} S.DmsArmed{}:
      clash_ft({S.DmsIdle{} == S.DmsArmed{} : S.Dms}, h)
    case S.DmsIdle{} S.DmsFired{}:
      clash_ft({S.DmsIdle{} == S.DmsFired{} : S.Dms}, h)
    case S.DmsArmed{} S.DmsIdle{}:
      clash_ft({S.DmsArmed{} == S.DmsIdle{} : S.Dms}, h)
    case S.DmsArmed{} S.DmsArmed{}:
      {==}
    case S.DmsArmed{} S.DmsFired{}:
      clash_ft({S.DmsArmed{} == S.DmsFired{} : S.Dms}, h)
    case S.DmsFired{} S.DmsIdle{}:
      clash_ft({S.DmsFired{} == S.DmsIdle{} : S.Dms}, h)
    case S.DmsFired{} S.DmsArmed{}:
      clash_ft({S.DmsFired{} == S.DmsArmed{} : S.Dms}, h)
    case S.DmsFired{} S.DmsFired{}:
      {==}

# lvl_eq: 4 x 4 rows
def Laws.lvl_eq_sound(a, b, h):
  match a b:
    case S.LNone{} S.LNone{}:
      {==}
    case S.LNone{} S.LJtt{}:
      clash_ft({S.LNone{} == S.LJtt{} : S.Level}, h)
    case S.LNone{} S.LRtps{}:
      clash_ft({S.LNone{} == S.LRtps{} : S.Level}, h)
    case S.LNone{} S.LPtn{}:
      clash_ft({S.LNone{} == S.LPtn{} : S.Level}, h)
    case S.LJtt{} S.LNone{}:
      clash_ft({S.LJtt{} == S.LNone{} : S.Level}, h)
    case S.LJtt{} S.LJtt{}:
      {==}
    case S.LJtt{} S.LRtps{}:
      clash_ft({S.LJtt{} == S.LRtps{} : S.Level}, h)
    case S.LJtt{} S.LPtn{}:
      clash_ft({S.LJtt{} == S.LPtn{} : S.Level}, h)
    case S.LRtps{} S.LNone{}:
      clash_ft({S.LRtps{} == S.LNone{} : S.Level}, h)
    case S.LRtps{} S.LJtt{}:
      clash_ft({S.LRtps{} == S.LJtt{} : S.Level}, h)
    case S.LRtps{} S.LRtps{}:
      {==}
    case S.LRtps{} S.LPtn{}:
      clash_ft({S.LRtps{} == S.LPtn{} : S.Level}, h)
    case S.LPtn{} S.LNone{}:
      clash_ft({S.LPtn{} == S.LNone{} : S.Level}, h)
    case S.LPtn{} S.LJtt{}:
      clash_ft({S.LPtn{} == S.LJtt{} : S.Level}, h)
    case S.LPtn{} S.LRtps{}:
      clash_ft({S.LPtn{} == S.LRtps{} : S.Level}, h)
    case S.LPtn{} S.LPtn{}:
      {==}

# phase_eq: 7 x 7 rows
def Laws.phase_eq_sound(a, b, h):
  match a b:
    case S.Breakdown{} S.Breakdown{}:
      {==}
    case S.Breakdown{} S.IpRise{}:
      clash_ft({S.Breakdown{} == S.IpRise{} : S.Phase}, h)
    case S.Breakdown{} S.Limiter{}:
      clash_ft({S.Breakdown{} == S.Limiter{} : S.Phase}, h)
    case S.Breakdown{} S.Xpoint{}:
      clash_ft({S.Breakdown{} == S.Xpoint{} : S.Phase}, h)
    case S.Breakdown{} S.Heating1{}:
      clash_ft({S.Breakdown{} == S.Heating1{} : S.Phase}, h)
    case S.Breakdown{} S.Heating2{}:
      clash_ft({S.Breakdown{} == S.Heating2{} : S.Phase}, h)
    case S.Breakdown{} S.Termination{}:
      clash_ft({S.Breakdown{} == S.Termination{} : S.Phase}, h)
    case S.IpRise{} S.Breakdown{}:
      clash_ft({S.IpRise{} == S.Breakdown{} : S.Phase}, h)
    case S.IpRise{} S.IpRise{}:
      {==}
    case S.IpRise{} S.Limiter{}:
      clash_ft({S.IpRise{} == S.Limiter{} : S.Phase}, h)
    case S.IpRise{} S.Xpoint{}:
      clash_ft({S.IpRise{} == S.Xpoint{} : S.Phase}, h)
    case S.IpRise{} S.Heating1{}:
      clash_ft({S.IpRise{} == S.Heating1{} : S.Phase}, h)
    case S.IpRise{} S.Heating2{}:
      clash_ft({S.IpRise{} == S.Heating2{} : S.Phase}, h)
    case S.IpRise{} S.Termination{}:
      clash_ft({S.IpRise{} == S.Termination{} : S.Phase}, h)
    case S.Limiter{} S.Breakdown{}:
      clash_ft({S.Limiter{} == S.Breakdown{} : S.Phase}, h)
    case S.Limiter{} S.IpRise{}:
      clash_ft({S.Limiter{} == S.IpRise{} : S.Phase}, h)
    case S.Limiter{} S.Limiter{}:
      {==}
    case S.Limiter{} S.Xpoint{}:
      clash_ft({S.Limiter{} == S.Xpoint{} : S.Phase}, h)
    case S.Limiter{} S.Heating1{}:
      clash_ft({S.Limiter{} == S.Heating1{} : S.Phase}, h)
    case S.Limiter{} S.Heating2{}:
      clash_ft({S.Limiter{} == S.Heating2{} : S.Phase}, h)
    case S.Limiter{} S.Termination{}:
      clash_ft({S.Limiter{} == S.Termination{} : S.Phase}, h)
    case S.Xpoint{} S.Breakdown{}:
      clash_ft({S.Xpoint{} == S.Breakdown{} : S.Phase}, h)
    case S.Xpoint{} S.IpRise{}:
      clash_ft({S.Xpoint{} == S.IpRise{} : S.Phase}, h)
    case S.Xpoint{} S.Limiter{}:
      clash_ft({S.Xpoint{} == S.Limiter{} : S.Phase}, h)
    case S.Xpoint{} S.Xpoint{}:
      {==}
    case S.Xpoint{} S.Heating1{}:
      clash_ft({S.Xpoint{} == S.Heating1{} : S.Phase}, h)
    case S.Xpoint{} S.Heating2{}:
      clash_ft({S.Xpoint{} == S.Heating2{} : S.Phase}, h)
    case S.Xpoint{} S.Termination{}:
      clash_ft({S.Xpoint{} == S.Termination{} : S.Phase}, h)
    case S.Heating1{} S.Breakdown{}:
      clash_ft({S.Heating1{} == S.Breakdown{} : S.Phase}, h)
    case S.Heating1{} S.IpRise{}:
      clash_ft({S.Heating1{} == S.IpRise{} : S.Phase}, h)
    case S.Heating1{} S.Limiter{}:
      clash_ft({S.Heating1{} == S.Limiter{} : S.Phase}, h)
    case S.Heating1{} S.Xpoint{}:
      clash_ft({S.Heating1{} == S.Xpoint{} : S.Phase}, h)
    case S.Heating1{} S.Heating1{}:
      {==}
    case S.Heating1{} S.Heating2{}:
      clash_ft({S.Heating1{} == S.Heating2{} : S.Phase}, h)
    case S.Heating1{} S.Termination{}:
      clash_ft({S.Heating1{} == S.Termination{} : S.Phase}, h)
    case S.Heating2{} S.Breakdown{}:
      clash_ft({S.Heating2{} == S.Breakdown{} : S.Phase}, h)
    case S.Heating2{} S.IpRise{}:
      clash_ft({S.Heating2{} == S.IpRise{} : S.Phase}, h)
    case S.Heating2{} S.Limiter{}:
      clash_ft({S.Heating2{} == S.Limiter{} : S.Phase}, h)
    case S.Heating2{} S.Xpoint{}:
      clash_ft({S.Heating2{} == S.Xpoint{} : S.Phase}, h)
    case S.Heating2{} S.Heating1{}:
      clash_ft({S.Heating2{} == S.Heating1{} : S.Phase}, h)
    case S.Heating2{} S.Heating2{}:
      {==}
    case S.Heating2{} S.Termination{}:
      clash_ft({S.Heating2{} == S.Termination{} : S.Phase}, h)
    case S.Termination{} S.Breakdown{}:
      clash_ft({S.Termination{} == S.Breakdown{} : S.Phase}, h)
    case S.Termination{} S.IpRise{}:
      clash_ft({S.Termination{} == S.IpRise{} : S.Phase}, h)
    case S.Termination{} S.Limiter{}:
      clash_ft({S.Termination{} == S.Limiter{} : S.Phase}, h)
    case S.Termination{} S.Xpoint{}:
      clash_ft({S.Termination{} == S.Xpoint{} : S.Phase}, h)
    case S.Termination{} S.Heating1{}:
      clash_ft({S.Termination{} == S.Heating1{} : S.Phase}, h)
    case S.Termination{} S.Heating2{}:
      clash_ft({S.Termination{} == S.Heating2{} : S.Phase}, h)
    case S.Termination{} S.Termination{}:
      {==}

# ---------------------------------------------------------------------------
# lvl_le: reflexive and antisymmetric under both orders
# ---------------------------------------------------------------------------

# lvl_le_refl: 2 x 4 rows, each by computation
def Laws.lvl_le_refl(o, a):
  match o a:
    case S.Ord1{} S.LNone{}:
      {==}
    case S.Ord1{} S.LJtt{}:
      {==}
    case S.Ord1{} S.LRtps{}:
      {==}
    case S.Ord1{} S.LPtn{}:
      {==}
    case S.Ord2{} S.LNone{}:
      {==}
    case S.Ord2{} S.LJtt{}:
      {==}
    case S.Ord2{} S.LRtps{}:
      {==}
    case S.Ord2{} S.LPtn{}:
      {==}

# lvl_le_sound: 2 x 4 x 4 rows; off the diagonal, h1 clashes when rank(a) > rank(b)
# (lvl_le(o, a, b) computes to False{}), h2 clashes when rank(a) < rank(b)
def Laws.lvl_le_sound(o, a, b, h1, h2):
  match o a b:
    case S.Ord1{} S.LNone{} S.LNone{}:
      {==}
    case S.Ord1{} S.LNone{} S.LJtt{}:
      clash_ft({S.LNone{} == S.LJtt{} : S.Level}, h2)
    case S.Ord1{} S.LNone{} S.LRtps{}:
      clash_ft({S.LNone{} == S.LRtps{} : S.Level}, h2)
    case S.Ord1{} S.LNone{} S.LPtn{}:
      clash_ft({S.LNone{} == S.LPtn{} : S.Level}, h2)
    case S.Ord1{} S.LJtt{} S.LNone{}:
      clash_ft({S.LJtt{} == S.LNone{} : S.Level}, h1)
    case S.Ord1{} S.LJtt{} S.LJtt{}:
      {==}
    case S.Ord1{} S.LJtt{} S.LRtps{}:
      clash_ft({S.LJtt{} == S.LRtps{} : S.Level}, h2)
    case S.Ord1{} S.LJtt{} S.LPtn{}:
      clash_ft({S.LJtt{} == S.LPtn{} : S.Level}, h2)
    case S.Ord1{} S.LRtps{} S.LNone{}:
      clash_ft({S.LRtps{} == S.LNone{} : S.Level}, h1)
    case S.Ord1{} S.LRtps{} S.LJtt{}:
      clash_ft({S.LRtps{} == S.LJtt{} : S.Level}, h1)
    case S.Ord1{} S.LRtps{} S.LRtps{}:
      {==}
    case S.Ord1{} S.LRtps{} S.LPtn{}:
      clash_ft({S.LRtps{} == S.LPtn{} : S.Level}, h2)
    case S.Ord1{} S.LPtn{} S.LNone{}:
      clash_ft({S.LPtn{} == S.LNone{} : S.Level}, h1)
    case S.Ord1{} S.LPtn{} S.LJtt{}:
      clash_ft({S.LPtn{} == S.LJtt{} : S.Level}, h1)
    case S.Ord1{} S.LPtn{} S.LRtps{}:
      clash_ft({S.LPtn{} == S.LRtps{} : S.Level}, h1)
    case S.Ord1{} S.LPtn{} S.LPtn{}:
      {==}
    case S.Ord2{} S.LNone{} S.LNone{}:
      {==}
    case S.Ord2{} S.LNone{} S.LJtt{}:
      clash_ft({S.LNone{} == S.LJtt{} : S.Level}, h2)
    case S.Ord2{} S.LNone{} S.LRtps{}:
      clash_ft({S.LNone{} == S.LRtps{} : S.Level}, h2)
    case S.Ord2{} S.LNone{} S.LPtn{}:
      clash_ft({S.LNone{} == S.LPtn{} : S.Level}, h2)
    case S.Ord2{} S.LJtt{} S.LNone{}:
      clash_ft({S.LJtt{} == S.LNone{} : S.Level}, h1)
    case S.Ord2{} S.LJtt{} S.LJtt{}:
      {==}
    case S.Ord2{} S.LJtt{} S.LRtps{}:
      clash_ft({S.LJtt{} == S.LRtps{} : S.Level}, h1)
    case S.Ord2{} S.LJtt{} S.LPtn{}:
      clash_ft({S.LJtt{} == S.LPtn{} : S.Level}, h2)
    case S.Ord2{} S.LRtps{} S.LNone{}:
      clash_ft({S.LRtps{} == S.LNone{} : S.Level}, h1)
    case S.Ord2{} S.LRtps{} S.LJtt{}:
      clash_ft({S.LRtps{} == S.LJtt{} : S.Level}, h2)
    case S.Ord2{} S.LRtps{} S.LRtps{}:
      {==}
    case S.Ord2{} S.LRtps{} S.LPtn{}:
      clash_ft({S.LRtps{} == S.LPtn{} : S.Level}, h2)
    case S.Ord2{} S.LPtn{} S.LNone{}:
      clash_ft({S.LPtn{} == S.LNone{} : S.Level}, h1)
    case S.Ord2{} S.LPtn{} S.LJtt{}:
      clash_ft({S.LPtn{} == S.LJtt{} : S.Level}, h1)
    case S.Ord2{} S.LPtn{} S.LRtps{}:
      clash_ft({S.LPtn{} == S.LRtps{} : S.Level}, h1)
    case S.Ord2{} S.LPtn{} S.LPtn{}:
      {==}

# ---------------------------------------------------------------------------
# fin_eq: the conjunction of the five component predicates, field by field
# ---------------------------------------------------------------------------

def Laws.fin_eq_sound(a, b, h):
  match a b:
    case S.Fin{+p, +l, +d, +pl, +nb, +rf} S.Fin{+p2, +l2, +d2, +pl2, +nb2, +rf2}:
      hp = and_l(Spec.phase_eq(p, p2), Bool.and(Spec.lvl_eq(l, l2), Bool.and(Spec.dms_eq(d, d2), Bool.and(Spec.beq(pl, pl2), Bool.and(Spec.unit_eq(nb, nb2), Spec.unit_eq(rf, rf2))))), h)
      +h1 = and_r(Spec.phase_eq(p, p2), Bool.and(Spec.lvl_eq(l, l2), Bool.and(Spec.dms_eq(d, d2), Bool.and(Spec.beq(pl, pl2), Bool.and(Spec.unit_eq(nb, nb2), Spec.unit_eq(rf, rf2))))), h)
      hl = and_l(Spec.lvl_eq(l, l2), Bool.and(Spec.dms_eq(d, d2), Bool.and(Spec.beq(pl, pl2), Bool.and(Spec.unit_eq(nb, nb2), Spec.unit_eq(rf, rf2)))), h1)
      +h2 = and_r(Spec.lvl_eq(l, l2), Bool.and(Spec.dms_eq(d, d2), Bool.and(Spec.beq(pl, pl2), Bool.and(Spec.unit_eq(nb, nb2), Spec.unit_eq(rf, rf2)))), h1)
      hd = and_l(Spec.dms_eq(d, d2), Bool.and(Spec.beq(pl, pl2), Bool.and(Spec.unit_eq(nb, nb2), Spec.unit_eq(rf, rf2))), h2)
      +h3 = and_r(Spec.dms_eq(d, d2), Bool.and(Spec.beq(pl, pl2), Bool.and(Spec.unit_eq(nb, nb2), Spec.unit_eq(rf, rf2))), h2)
      hpl = and_l(Spec.beq(pl, pl2), Bool.and(Spec.unit_eq(nb, nb2), Spec.unit_eq(rf, rf2)), h3)
      +h4 = and_r(Spec.beq(pl, pl2), Bool.and(Spec.unit_eq(nb, nb2), Spec.unit_eq(rf, rf2)), h3)
      hnb = and_l(Spec.unit_eq(nb, nb2), Spec.unit_eq(rf, rf2), h4)
      hrf = and_r(Spec.unit_eq(nb, nb2), Spec.unit_eq(rf, rf2), h4)
      ep = Laws.phase_eq_sound(p, p2, hp)
      el = Laws.lvl_eq_sound(l, l2, hl)
      ed = Laws.dms_eq_sound(d, d2, hd)
      epl = Laws.beq_sound(pl, pl2, hpl)
      enb = Laws.unit_eq_sound(nb, nb2, hnb)
      erf = Laws.unit_eq_sound(rf, rf2, hrf)
      %ep : {S.Fin{p, l, d, pl, nb, rf} == S.Fin{_, l2, d2, pl2, nb2, rf2} : S.Fin}
      %el : {S.Fin{p, l, d, pl, nb, rf} == S.Fin{p, _, d2, pl2, nb2, rf2} : S.Fin}
      %ed : {S.Fin{p, l, d, pl, nb, rf} == S.Fin{p, l, _, pl2, nb2, rf2} : S.Fin}
      %epl : {S.Fin{p, l, d, pl, nb, rf} == S.Fin{p, l, d, _, nb2, rf2} : S.Fin}
      %enb : {S.Fin{p, l, d, pl, nb, rf} == S.Fin{p, l, d, pl, _, rf2} : S.Fin}
      %erf : {S.Fin{p, l, d, pl, nb, rf} == S.Fin{p, l, d, pl, nb, _} : S.Fin}
      {==}
