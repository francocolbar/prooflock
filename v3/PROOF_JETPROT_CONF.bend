def Laws.fast_ptn(i, s):
  match i:
    case S.Inst1{}:
      match s:
        case S.St{S.Fin{p, l, d, pl, nb, rf}, hb, tack}:
          match p d:
            case S.Breakdown{} S.DmsIdle{}:
              {==}
            case S.Breakdown{} S.DmsArmed{}:
              {==}
            case S.Breakdown{} S.DmsFired{}:
              {==}
            case S.IpRise{} S.DmsIdle{}:
              {==}
            case S.IpRise{} S.DmsArmed{}:
              {==}
            case S.IpRise{} S.DmsFired{}:
              {==}
            case S.Limiter{} S.DmsIdle{}:
              {==}
            case S.Limiter{} S.DmsArmed{}:
              {==}
            case S.Limiter{} S.DmsFired{}:
              {==}
            case S.Xpoint{} S.DmsIdle{}:
              {==}
            case S.Xpoint{} S.DmsArmed{}:
              {==}
            case S.Xpoint{} S.DmsFired{}:
              {==}
            case S.Heating1{} S.DmsIdle{}:
              {==}
            case S.Heating1{} S.DmsArmed{}:
              {==}
            case S.Heating1{} S.DmsFired{}:
              {==}
            case S.Heating2{} S.DmsIdle{}:
              {==}
            case S.Heating2{} S.DmsArmed{}:
              {==}
            case S.Heating2{} S.DmsFired{}:
              {==}
            case S.Termination{} S.DmsIdle{}:
              {==}
            case S.Termination{} S.DmsArmed{}:
              {==}
            case S.Termination{} S.DmsFired{}:
              {==}
    case S.Inst2{}:
      match s:
        case S.St{S.Fin{p, l, d, pl, nb, rf}, hb, tack}:
          match p d:
            case S.Breakdown{} S.DmsIdle{}:
