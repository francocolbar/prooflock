# emit.bend (v2) - prints the JAX module for one explicit step of the scheme r = p/2^q
# read from BEND_P and BEND_Q, generated from the linear normal form of the RAW tree.

import Base
import ./../num/z.bend as Z
import ./ir.bend as IR

def or_zero(m: Maybe<&2, Nat>) -> Nat:
  match m:
    case None{}:
      0n
    case Some{n}:
      n

def module_src(ps: String, qs: String) -> String:
  +s = {IR.Scheme{or_zero(Nat.read(ps)), or_zero(Nat.read(qs))} : IR.Scheme}
  +e = IR.stencil(s)
  +l = IR.lin(e)
  "# Generated by bend-spike/v2/heat/emit.bend (Bend 2). Do not edit.\n" ++
  "# Scheme: D u_i' = D u_i + p (u_{i-1} - 2 u_i + u_{i+1}),  r = alpha dt / dx^2 = p / D\n" ++
  "# p = " ++ Nat.show(IR.p_of(s)) ++ ", D = " ++ Z.Z.show(IR.den(s)) ++ "\n" ++
  "# raw IR:      " ++ IR.show(e) ++ "\n" ++
  "# normal form: " ++ IR.show_lin(l) ++ "   (LAWS_HEAT.lin_sound: same meaning as the raw IR)\n" ++
  "import jax\n" ++
  "import jax.numpy as jnp\n" ++
  "\n" ++
  "jax.config.update('jax_enable_x64', True)\n" ++
  "\n" ++
  "P = " ++ Nat.show(IR.p_of(s)) ++ "\n" ++
  "D = " ++ Z.Z.show(IR.den(s)) ++ ".0\n" ++
  "\n" ++
  "\n" ++
  "@jax.jit\n" ++
  "def step(u):\n" ++
  "    # one explicit Euler step; u[0] and u[-1] are Dirichlet boundaries and stay put\n" ++
  "    inner = (" ++ IR.py_lin(l) ++ ") / D\n" ++
  "    return u.at[1:-1].set(inner)\n"

def main() -> IO(Unit):
  do IO<Unit>:
    ps : String <- IO.try(String, IO.get_env("BEND_P"))
    qs : String <- IO.try(String, IO.get_env("BEND_Q"))
    IO.write(module_src(ps, qs))
