# emit.bend - prints to stdout the Python/JAX module holding one explicit time step
# of the scheme, generated from the SIMPLIFIED IR (interop route A: stdout -> .py).

import Base
import ./ir.bend as IR

def module_src() -> String:
  +s = IR.heat_scheme()
  +e = IR.stencil(s)
  +simp = IR.simplify(e)
  "# Generated by bend-spike/heat/emit.bend (Bend 2). Do not edit.\n" ++
  "# Scheme: D u_i' = w_l u_{i-1} + w_c u_i + w_r u_{i+1}, r = alpha dt / dx^2 = p / D\n" ++
  "# weights [w_l, w_c, w_r] = " ++ List.show(~&2, ~Nat, ~Nat.show, IR.weights(s)) ++ ", D = " ++ Nat.show(IR.den(s)) ++ "\n" ++
  "# raw IR:        " ++ IR.show(e) ++ "\n" ++
  "# simplified IR: " ++ IR.show(simp) ++ "\n" ++
  "# LAWS.bend/PROOF.bend: eval(simplify(e)) == eval(e) for every window (simplify_sound).\n" ++
  "import jax\n" ++
  "import jax.numpy as jnp\n" ++
  "\n" ++
  "jax.config.update('jax_enable_x64', True)\n" ++
  "\n" ++
  "D = " ++ Nat.show(IR.den(s)) ++ ".0\n" ++
  "\n" ++
  "\n" ++
  "@jax.jit\n" ++
  "def step(u):\n" ++
  "    # one explicit Euler step; u[0] and u[-1] are Dirichlet boundaries and stay put\n" ++
  "    inner = " ++ IR.py(simp) ++ " / D\n" ++
  "    return u.at[1:-1].set(inner)\n"

def main() -> IO(Unit):
  IO.write(module_src())
